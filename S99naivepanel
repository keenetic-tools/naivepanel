#!/bin/sh
# /opt/etc/init.d/S99naivepanel
# Init-скрипт для NaivePanel (Flask UI) на Entware (Keenetic).
#
# Ожидает:
#   /opt/naivepanel/naivepanel.py — основной скрипт
#   /opt/bin/python3 или /opt/bin/python — интерпретатор (из пакета python3 в Entware)
#   /opt/var/run/naivepanel.pid — pid
#   /opt/var/log/naivepanel.log — stdout/stderr
#
# Команды: start | stop | restart | status
#
# Конфигурация через переменные окружения (можно задать в /opt/etc/init.d/rc.conf):
#   NAIVEPANEL_BIND=127.0.0.1:8089
#   NAIVEPANEL_HOSTS=192.168.1.1:8089,...            # allowlist Host (анти-rebinding); пусто = выкл
#   NAIVEPROXY_DIR=/opt/etc/naiveproxy
#   NAIVEPROXY_INIT=/opt/etc/init.d/S99naiveproxy
#   NAIVEPROXY_LOG=/opt/var/log/naiveproxy.log
#   NAIVEPANEL_PASS=/opt/etc/naivepanel/admin.pass   # если файла нет — auth отключена

ENABLED=yes
PROG=naivepanel
APP=/opt/naivepanel/naivepanel.py
PIDFILE=/opt/var/run/naivepanel.pid
LOGFILE=/opt/var/log/naivepanel.log

# Defaults (можно переопределить в /opt/etc/init.d/rc.conf перед вызовом)
: ${NAIVEPANEL_BIND:=127.0.0.1:8089}
: ${NAIVEPANEL_HOSTS:=}
: ${NAIVEPROXY_DIR:=/opt/etc/naiveproxy}
: ${NAIVEPROXY_INIT:=/opt/etc/init.d/S99naiveproxy}
: ${NAIVEPROXY_LOG:=/opt/var/log/naiveproxy.log}
: ${NAIVEPROXY_PID:=/opt/var/run/naiveproxy.pid}
: ${NAIVEPANEL_PASS:=/opt/etc/naivepanel/admin.pass}
export NAIVEPANEL_BIND NAIVEPANEL_HOSTS NAIVEPROXY_DIR NAIVEPROXY_INIT NAIVEPROXY_LOG NAIVEPROXY_PID NAIVEPANEL_PASS

# python в Entware живёт в /opt/bin; fallback — системный
PYTHON=/opt/bin/python3
[ -x "$PYTHON" ] || PYTHON=/opt/bin/python
[ -x "$PYTHON" ] || PYTHON=$(command -v python3 || echo python3)

running() {
    [ -f "$PIDFILE" ] || return 1
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    kill -0 "$pid" 2>/dev/null
}

start() {
    if running; then
        echo "$PROG already running (pid=$(cat "$PIDFILE"))"
        return 0
    fi
    [ -f "$APP" ] || { echo "no app: $APP"; return 1; }
    [ -d /opt/var/log ] || mkdir -p /opt/var/log
    [ -d /opt/var/run ] || mkdir -p /opt/var/run
    echo "starting $PROG on $NAIVEPANEL_BIND"
    nohup "$PYTHON" "$APP" >>"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if running; then
        echo "$PROG started (pid=$(cat "$PIDFILE"))"
        return 0
    else
        echo "$PROG failed to start; see $LOGFILE"
        rm -f "$PIDFILE"
        return 1
    fi
}

stop() {
    if ! running; then
        echo "$PROG not running"
        rm -f "$PIDFILE"
        return 0
    fi
    local pid
    pid=$(cat "$PIDFILE")
    echo "stopping $PROG (pid=$pid)"
    kill -TERM "$pid" 2>/dev/null
    for _ in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    rm -f "$PIDFILE"
    return 0
}

status() {
    if running; then
        echo "$PROG is running (pid=$(cat "$PIDFILE"))"
        return 0
    else
        echo "$PROG is NOT running"
        return 1
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac

exit $?
