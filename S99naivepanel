#!/bin/sh
# /opt/etc/init.d/S99naivepanel
# Init-скрипт для NaivePanel (Flask UI) на Entware (Keenetic).
#
# НАСТРОЕК ЗДЕСЬ НЕТ: установщик перезаписывает этот файл при каждом
# обновлении. Все настройки панели — в /opt/etc/naive/panel/panel.conf,
# который читает сам naivepanel.py (ключи и примеры — в README и в самом
# файле-шаблоне). Окружение (env) перекрывает panel.conf.
#
# Ожидает:
#   /opt/etc/naive/panel/naivepanel.py — основной скрипт
#   /opt/bin/python3 или /opt/bin/python — интерпретатор (из пакета python3 в Entware)
#   /opt/var/run/naivepanel.pid — pid
#   /opt/var/log/naivepanel.log — stdout/stderr
#
# Команды: start | stop | restart | status

ENABLED=yes
PROG=naivepanel
APP=/opt/etc/naive/panel/naivepanel.py
PIDFILE=/opt/var/run/naivepanel.pid
LOGFILE=/opt/var/log/naivepanel.log
CONF=/opt/etc/naive/panel/panel.conf

# python в Entware живёт в /opt/bin; fallback — системный
PYTHON=/opt/bin/python3
[ -x "$PYTHON" ] || PYTHON=/opt/bin/python
[ -x "$PYTHON" ] || PYTHON=$(command -v python3 || echo python3)

running() {
    [ -f "$PIDFILE" ] || return 1
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    kill -0 "$pid" 2>/dev/null
}

# грубая ротация: лог аппендится без ограничений, не даём разрастись на USB
truncate_log() {
    [ -f "$LOGFILE" ] || return 0
    if [ "$(wc -c <"$LOGFILE")" -gt 5242880 ]; then
        : > "$LOGFILE"
        echo "truncated oversized $LOGFILE (>5M)"
    fi
}

start() {
    if running; then
        echo "$PROG already running (pid=$(cat "$PIDFILE"))"
        return 0
    fi
    [ -f "$APP" ] || { echo "no app: $APP"; return 1; }
    [ -d /opt/var/log ] || mkdir -p /opt/var/log
    [ -d /opt/var/run ] || mkdir -p /opt/var/run
    truncate_log
    # bind показываем из panel.conf чисто для лога — сам файл шеллом не
    # исполняется (сломанная строка в конфиге не должна уронить сервис)
    bind=$(sed -n 's/^[[:space:]]*NAIVEPANEL_BIND=//p' "$CONF" 2>/dev/null | head -n 1 | tr -d '"')
    echo "starting $PROG on ${bind:-127.0.0.1:8089}"
    nohup "$PYTHON" "$APP" >>"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if running; then
        echo "$PROG started (pid=$(cat "$PIDFILE"))"
        return 0
    else
        echo "$PROG failed to start; see $LOGFILE"
        rm -f "$PIDFILE"
        return 1
    fi
}

stop() {
    if ! running; then
        echo "$PROG not running"
        rm -f "$PIDFILE"
        return 0
    fi
    local pid
    pid=$(cat "$PIDFILE")
    echo "stopping $PROG (pid=$pid)"
    kill -TERM "$pid" 2>/dev/null
    for _ in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    rm -f "$PIDFILE"
    return 0
}

status() {
    if running; then
        echo "$PROG is running (pid=$(cat "$PIDFILE"))"
        return 0
    else
        echo "$PROG is NOT running"
        return 1
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac

exit $?
